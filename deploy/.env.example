# Aegis HealthSec — deployment environment template.
# Copy to a local .env (gitignored) and fill with YOUR OWN values. This file
# contains placeholders only and MUST NOT contain real credentials.
#
# Generate strong secrets, e.g.:
#   openssl rand -hex 32   # AEGIS_JWT_SECRET
#   openssl rand -hex 24   # AEGIS_DB_PASSWORD

# Required (deployment refuses to start without these):
AEGIS_DB_PASSWORD=change-me-generate-a-strong-value
AEGIS_JWT_SECRET=change-me-min-32-chars-generate-a-strong-value

# Optional first-run administrator bootstrap (min 12 chars when secure config on):
AEGIS_ADMIN_USER=admin
AEGIS_ADMIN_PASSWORD=change-me-strong-admin-password
AEGIS_ADMIN_ORG=default

# Enforce secure configuration at startup (set to 1 in any deployment):
AEGIS_REQUIRE_SECURE_CONFIG=1

# Optional tuning:
# AEGIS_TOKEN_TTL_MIN=60
# AEGIS_MAX_BATCH=1000
# AEGIS_MAX_BODY_BYTES=2097152
# AEGIS_JWT_ISSUER=aegis-healthsec
# AEGIS_JWT_AUDIENCE=aegis-healthsec-api
